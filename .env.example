# 필수: 게임 상태 토큰 서명용 비밀값 (아무 긴 랜덤 문자열)
SESSION_SECRET=

# LLM (OpenRouter). 비워두면 대본 모드로 동작해 실제 호출 없이 화면을 확인할 수 있다.
OPENROUTER_API_KEY=
# 상태 판정은 저비용 모델, 실제 NPC 대사는 자연스러운 말투를 위한 모델로 분리한다.
FRAME_MODEL=openai/gpt-5.4-mini
NPC_DIALOGUE_MODEL=openai/gpt-5.6-terra
# 이전 호환용: 지정하면 위 두 모델을 모두 덮어쓴다.
# NPC_MODEL=

# 선택: 대화 로그 저장과 참가자 수 표시 (supabase/schema.sql 먼저 실행)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 전체 판 수 상한. 넘으면 "위원회 휴정" 화면. Supabase 연결 시에만 동작
MAX_TOTAL_PLAYS=300

# 선택: Microsoft Clarity 프로젝트 ID (실시간 접속자, 화면 녹화). 빌드할 때 들어가므로 Vercel 환경 변수에 넣고 다시 배포
VITE_CLARITY_ID=
